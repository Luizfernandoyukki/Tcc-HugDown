extends ../layout

block styles
  link(rel="stylesheet", href="/stylesheets/grupos/show.css")

block content
  a.btn.btn-outline-secondary.mb-3.d-flex.align-items-center.justify-content-start(style="max-width:120px;" href="/")
    i.fas.fa-arrow-left.me-2
    | Voltar
  .container.py-5
    // Botão para criar novo grupo no topo
    .d-flex.justify-content-between.align-items-center.mb-4
      h2.mb-0 Grupos Disponíveis
      if usuario
        a.btn.btn-primary(href="/grupos/create")
          i.fas.fa-plus.me-2
          | Criar novo grupo

    // Listagem de todos os grupos por categoria
    if grupos && grupos.length
      // Agrupar por categoria
      - var gruposPorCategoria = {};
      - grupos.forEach(function(g) {
      -   var cat = g.categoria ? g.categoria.nome_categoria : 'Sem Categoria';
      -   if (!gruposPorCategoria[cat]) gruposPorCategoria[cat] = [];
      -   gruposPorCategoria[cat].push(g);
      - });
      
      each categoria in Object.keys(gruposPorCategoria).sort()
        h4.mt-4.mb-3= categoria
        .row.g-4.mb-5
          each g in gruposPorCategoria[categoria]
            .col-md-6.col-lg-4
              .card.grupo-card
                if g.foto_grupo
                  img.card-img-top.grupo-image(src=g.foto_grupo, alt=g.nome_grupo)
                else
                  img.card-img-top.grupo-image(src="/images/default-group.png", alt="Grupo padrão")
                
                if g.tipo_privacidade !== 'public'
                  span.badge.bg-secondary.grupo-badge
                    i.fas.fa-lock.me-1
                    = g.tipo_privacidade
                
                .grupo-details
                  h5.card-title= g.nome_grupo
                  if g.descricao_grupo
                    p.text-muted= g.descricao_grupo.substring(0, 100) + (g.descricao_grupo.length > 100 ? '...' : '')
                  .grupo-members
                    i.fas.fa-users.me-2
                    | #{g.membros ? g.membros.length : 0}
                    if g.max_participantes
                      |  / #{g.max_participantes}
                  if g.categoria
                    span.badge.bg-primary= g.categoria.nome_categoria
                  a.stretched-link(href=`/grupos/${g.id_grupo}`)
    else
      p.text-muted Nenhum grupo encontrado.

    // Visualização individual do grupo selecionado
    if grupo
      hr.mt-5
      .row.mt-4
        .col-md-8
          .card
            .card-body
              h2.card-title.mb-3= grupo.nome_grupo
              if grupo.foto_grupo
                img.img-fluid.rounded.mb-3(src=grupo.foto_grupo, alt="Foto do grupo", style="max-width:200px;")
              else
                img.img-fluid.rounded.mb-3(src="/images/default-group.png", alt="Grupo padrão", style="max-width:200px;")
              
              p.text-muted.mb-3= grupo.descricao_grupo
              
              .grupo-info
                p
                  i.fas.fa-lock.me-2
                  b Tipo de privacidade: 
                  | #{grupo.tipo_privacidade}
                p
                  i.fas.fa-user-shield.me-2
                  b Administrador: 
                  | #{grupo.administrador ? grupo.administrador.nome_usuario : 'Desconhecido'}
                p
                  i.fas.fa-users.me-2
                  b Membros: 
                  | #{grupo.membros ? grupo.membros.length : 0}
                  if grupo.max_participantes
                    |  / #{grupo.max_participantes}

              if !usuarioEhMembro
                form.mt-4(method="post", action=`/grupos/${grupo.id_grupo}/participar`)
                  button.btn.btn-success.btn-lg(type="submit")
                    i.fas.fa-user-plus.me-2
                    | Participar do grupo
              // if usuario
                // button.btn.btn-danger.mt-3(type="button", onclick=`abrirModalReportGrupo(${grupo.id_grupo}, '${grupo.nome_grupo}')`) Reportar Grupo

