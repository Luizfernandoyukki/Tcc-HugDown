extends ../layout

block styles
  link(rel="stylesheet", href="/stylesheets/grupos/show.css")

block content
  a.btn.btn-outline-secondary.mb-3.d-flex.align-items-center.justify-content-start(style="max-width:120px;" href="/")
    i.fas.fa-arrow-left.me-2
    | Voltar
  .container.py-5
    // Botão para criar novo grupo no topo
    .d-flex.justify-content-between.align-items-center.mb-4
      h2.mb-0 Grupos Disponíveis
      if usuario
        a.btn.btn-primary(href="/grupos/create")
          i.fas.fa-plus.me-2
          | Criar novo grupo

    // Barra de pesquisa de grupos
    .search-box.mb-4
      input.form-control#search-grupo(type="text", placeholder="Pesquisar grupos por nome...")

    // Listagem de todos os grupos
    if grupos && grupos.length
      .row.g-4.mb-5
        each g in grupos
          .col-md-6.col-lg-4
            .card.grupo-card(data-nome-grupo=g.nome_grupo.toLowerCase())
              if g.foto_grupo
                img.card-img-top.grupo-image(src=g.foto_grupo, alt=g.nome_grupo)
              else
                img.card-img-top.grupo-image(src="/images/default-group.png", alt="Grupo padrão")
              if g.tipo_privacidade !== 'public'
                span.badge.bg-secondary.grupo-badge
                  i.fas.fa-lock.me-1
                  = g.tipo_privacidade
              .grupo-details
                h5.card-title= g.nome_grupo
                if g.descricao_grupo
                  p.text-muted= g.descricao_grupo.substring(0, 100) + (g.descricao_grupo.length > 100 ? '...' : '')
                .grupo-members
                  i.fas.fa-users.me-2
                  | #{g.membros ? g.membros.length : 0}
                  if g.max_participantes
                    |  / #{g.max_participantes}
                a.stretched-link(href=`/grupos/${g.id_grupo}`)
    else
      p.text-muted Nenhum grupo encontrado.

    // Visualização individual do grupo selecionado
    if grupo
      hr.mt-5
      .row.mt-4
        .col-md-8
          .card
            .card-body
              h2.card-title.mb-3= grupo.nome_grupo
              if grupo.foto_grupo
                img.img-fluid.rounded.mb-3(src=grupo.foto_grupo, alt="Foto do grupo", style="max-width:200px;")
              else
                img.img-fluid.rounded.mb-3(src="/images/default-group.png", alt="Grupo padrão", style="max-width:200px;")
              
              p.text-muted.mb-3= grupo.descricao_grupo
              
              .grupo-info
                p
                  i.fas.fa-lock.me-2
                  b Tipo de privacidade: 
                  | #{grupo.tipo_privacidade}
                p
                  i.fas.fa-user-shield.me-2
                  b Administrador: 
                  | #{grupo.administrador ? grupo.administrador.nome_usuario : 'Desconhecido'}
                p
                  i.fas.fa-users.me-2
                  b Membros: 
                  | #{grupo.membros ? grupo.membros.length : 0}
                  if grupo.max_participantes
                    |  / #{grupo.max_participantes}

              if !usuarioEhMembro
                form.mt-4(method="post", action=`/grupos/${grupo.id_grupo}/participar`)
                  button.btn.btn-success.btn-lg(type="submit")
                    i.fas.fa-user-plus.me-2
                    | Participar do grupo
block scripts
  script(src="/javascripts/grupos/show.js")
  script.
    // Filtro de pesquisa de grupos por nome (funciona para cards)
    document.addEventListener('DOMContentLoaded', function() {
      const input = document.getElementById('search-grupo');
      if (!input) return;
      input.addEventListener('input', function() {
        const termo = input.value.trim().toLowerCase();
        let algum = false;
        document.querySelectorAll('.card.grupo-card').forEach(card => {
          const nome = card.querySelector('.card-title')?.textContent.trim().toLowerCase() || '';
          const show = nome.includes(termo);
          card.parentElement.style.display = show ? '' : 'none';
          if (show) algum = true;
        });
        // Opcional: mostrar mensagem se nenhum grupo encontrado
        const emptyMsg = document.querySelector('.no-grupos-msg');
        if (emptyMsg) emptyMsg.style.display = algum ? 'none' : '';
      });
    });
  // Adiciona o search.js global para barra de pesquisa funcionar
  script(src="/javascripts/search.js")
