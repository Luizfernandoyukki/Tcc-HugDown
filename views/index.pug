extends layout

block styles
  link(rel="stylesheet" href="/stylesheets/index.css")

block content
  main.main-wrapper
    // Hero Section
    section.hero-section.mb-5
      .container
        .row.align-items-center.min-vh-100
          .col-lg-6
            .hero-content
              h1.hero-title HugDown
              p.hero-subtitle Conecte-se, participe e transforme sua experiência social
              p.hero-description Encontre pessoas com interesses similares, participe de eventos incríveis e faça parte de grupos que realmente importam para você.
              .hero-actions
                if isLoggedIn
                  a.btn.btn-primary.btn-lg.me-3(href="/feed")
                    i.fas.fa-rss.me-2
                    | Feed de Postagens
                  a.btn.btn-outline-light.btn-lg(href="/eventos") 
                    i.fas.fa-compass.me-2
                    | Explorar
                else
                  a.btn.btn-primary.btn-lg.me-3(href="/login")
                    i.fas.fa-sign-in-alt.me-2
                    | Entrar
          .col-lg-6
            .hero-illustration
              .floating-cards
                .card.floating-card.card-1.mb-4
                  .card-body
                    i.fas.fa-users.text-primary
                    h6 Grupos Ativos
                    span.counter#group-count 
                .card.floating-card.card-2.mb-4
                  .card-body
                    i.fas.fa-calendar-alt.text-success
                    h6 Eventos
                    span.counter#event-count 
                .card.floating-card.card-3.mb-4
                  .card-body
                    i.fas.fa-heart.text-danger
                    h6 Conexões
                    span.counter#user-count 

    // Features Section
    section#explore.features-section.py-5.mb-5
      .container
        .row.text-center.mb-5
          .col-12
            h2.section-title Como funciona o HugDown?
            p.section-subtitle Tudo que você precisa para uma vida social mais rica
        
        .row.g-4
          .col-md-4
            .feature-card.h-100
              .feature-icon
                i.fas.fa-search
              h4 Descubra
              p Encontre grupos e eventos que combinam com seus interesses e localização
              .feature-link
                if isLoggedIn
                  a.btn.btn-outline-primary(href="/eventos") Ver Eventos
                else
                  a.btn.btn-outline-primary.disabled(href="#") Faça login para ver

          .col-md-4
            .feature-card.h-100
              .feature-icon
                i.fas.fa-users
              h4 Conecte-se
              p Participe de comunidades ativas e faça conexões genuínas
              .feature-link
                if isLoggedIn
                  a.btn.btn-outline-primary(href="/grupos") Ver Grupos
                else
                  a.btn.btn-outline-primary.disabled(href="#") Faça login para ver

          .col-md-4
            .feature-card.h-100
              .feature-icon
                i.fas.fa-rocket
              h4 Crie
              p Organize seus próprios eventos e lidere grupos sobre seus temas favoritos
              .feature-link
                if isLoggedIn
                  a.btn.btn-outline-primary(href="/eventos/create") Criar Evento
                else
                  a.btn.btn-outline-primary.disabled(href="#") Faça login para criar

    // Stats Section
    section.stats-section.py-5.mb-5
      .container
        .row.text-center
          .col-md-3.col-6.mb-4
            .stat-item
              .stat-number#total-users 
              .stat-label Usuários Ativos
          .col-md-3.col-6.mb-4
            .stat-item
              .stat-number#total-events 
              .stat-label Eventos Realizados
          .col-md-3.col-6.mb-4
            .stat-item
              .stat-number#total-groups 
              .stat-label Grupos Criados
          .col-md-3.col-6.mb-4
            .stat-item
              .stat-number#total-connections 
              .stat-label Conexões

    // Recent Activity Section
    section.activity-section.py-5.mb-5
      .container
        .row
          .col-lg-8
            h3.mb-4 Atividades Recentes
            .activity-feed
              .loading-placeholder
                .d-flex.align-items-center
                  .spinner-border.spinner-border-sm.me-2(role="status")
                  span Carregando atividades...
          
          .col-lg-4
            .sidebar-widget
              h4.mb-3.text-success.fw-bold
                i.fas.fa-calendar-day.me-2
                | Próximos Eventos
              .upcoming-events
                .upcoming-events-list
                  .loading-placeholder
                    .d-flex.align-items-center
                      .spinner-border.spinner-border-sm.me-2(role="status")
                      span Carregando eventos...

    // CTA Section
    section.cta-section.py-5.mb-5
      .container.text-center
        if isLoggedIn
          h2 Você já está pronto!
          p.lead Aproveite todos os recursos da plataforma.
        else
          h2 Pronto para começar?
          p.lead Junte-se a milhares de pessoas que já encontraram sua comunidade
          a.btn.btn-primary.btn-lg(href="/login")
            i.fas.fa-arrow-right.me-2
            | Entrar no HugDown
            

block scripts
  script(src="/javascripts/index.js")
  script(src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js")