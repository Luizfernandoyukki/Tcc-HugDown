extends ../layout

block styles
  link(rel="stylesheet", href="/stylesheets/postagens/edit.css")

block content
  .container
    .edit-card
      h2 Editar Postagem
      form#form-edit(method="POST" action=`/postagens/${post.id_postagem}?_method=PUT`)
        .mb-3
          label(for="titulo") Título
          input.form-control(type="text", id="titulo", name="titulo", value=post.titulo)
        .mb-3
          label(for="resumo") Resumo
          textarea.form-control(id="resumo", name="resumo")= post.resumo
        .mb-3
          label(for="conteudo") Conteúdo
          textarea.form-control(id="conteudo", name="conteudo")= post.conteudo
        button.btn.btn-success.mt-3(type="submit") 
          i.fas.fa-save.me-2
          | Salvar Alterações

block scripts
  script(src="/javascripts/postagens/edit.js")