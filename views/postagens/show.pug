extends ../layout

block styles
  link(rel="stylesheet", href="/stylesheets/postagens/show.css")

block content
  .container.mt-5
    a.btn.btn-outline-secondary.mb-3.d-flex.align-items-center.justify-content-start(style="max-width:120px;" href="javascript:history.back()")
      i.fas.fa-arrow-left.me-2
      | Voltar
    h2.text-success.text-center.mb-4 Minhas Postagens
    p.text-center.text-muted Bem-vindo, #{usuario ? usuario.nome_usuario : 'visitante'}! Aqui estão suas postagens.
    // Barra de pesquisa por título
    .mb-4
      input.form-control(type="text", id="busca-titulo-post", placeholder="Pesquisar por título ou conteúdo...")

    if postagens && postagens.length
      .row.g-4
        each post in postagens
          .col-12.col-md-6.col-lg-4
            .card.shadow-sm.h-100.post-card(style="cursor:pointer;" data-id=post.id_postagem)
              .card-body
                h5.card-title= post.titulo || 'Sem título'
                if post.resumo
                  p.card-text.text-truncate.pre-content(style="white-space:pre-line")= post.resumo
                small.text-muted= post.data_criacao ? post.data_criacao.toLocaleString ? post.data_criacao.toLocaleString() : post.data_criacao : ''
                if post.url_midia
                  if post.tipo_postagem === 'photo'
                    img.img-fluid.mb-2(src=post.url_midia, alt="Imagem da postagem", style="max-width:100%;height:auto;", onerror="this.src='/images/default-post.png'")
                  else if post.tipo_postagem === 'video'
                    video.img-fluid.mb-2(controls, style="max-width:100%;height:auto;")
                      source(src=post.url_midia, type="video/mp4")
                      | Seu navegador não suporta vídeo.
                  else
                    // fallback para outros tipos
                    img.img-fluid.mb-2(src=post.url_midia, alt="Arquivo da postagem", style="max-width:100%;height:auto;", onerror="this.src='/images/default-post.png'")
    else
      .d-flex.justify-content-center.align-items-center.mt-5(style="min-height:300px;")
        .card.bg-dark.text-white.p-4(style="max-width: 420px; border-radius: 18px; box-shadow: 0 0 16px #000;")
          h4.mb-3 Nenhuma postagem encontrada
          p.mb-0 Você ainda não criou nenhuma postagem. Clique em "Nova Postagem" para começar!

  // Modal/Card de visualização detalhada
  .modal.fade#modalPostagem(tabindex="-1", aria-hidden="true")
    .modal-dialog.modal-xl.modal-dialog-centered(style="max-width:60vw;")
      .modal-content
        .modal-header
          h4.modal-title#modalTitulo
          button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Fechar")
        .modal-body
          p#modalConteudo.pre-content(style="white-space:pre-line")
          ul.list-group
            li.list-group-item
              b Categoria: 
              span#modalCategoria
            li.list-group-item
              b Tags: 
              span#modalTags
            li.list-group-item
              b Data de criação: 
              span#modalData
            li.list-group-item
              b Tipo de postagem: 
              span#modalTipo
            li.list-group-item
              b Artigo científico: 
              span#modalArtigo
            li.list-group-item
              b Latitude: 
              span#modalLat
            li.list-group-item
              b Longitude: 
              span#modalLng
        .modal-footer.justify-content-end
          a#btnEditarPost.btn.btn-warning.btn-lg.d-flex.align-items-center(href="#")
            i.fas.fa-edit.fs-2.me-2
            .d-flex.flex-column.align-items-start
              span.fs-5 Editar Postagem
              small.text-warning-50 Altere o conteúdo desta postagem.

block scripts
  script.
    window.postagens = !{postagensJson};
    // Filtro de pesquisa por título ou conteúdo
    document.addEventListener('DOMContentLoaded', function() {
      const input = document.getElementById('busca-titulo-post');
      if (!input) return;
      input.addEventListener('input', function() {
        const termo = input.value.trim().toLowerCase();
        let algum = false;
        document.querySelectorAll('.post-card').forEach(card => {
          const titulo = card.querySelector('.card-title')?.textContent.trim().toLowerCase() || '';
          const resumo = card.querySelector('.card-text')?.textContent.trim().toLowerCase() || '';
          const show = titulo.includes(termo) || resumo.includes(termo);
          card.style.display = show ? '' : 'none';
          if (show) algum = true;
        });
        // Exibe mensagem se nenhum post encontrado
        const container = document.querySelector('.row.g-4');
        if (container) container.style.display = algum ? '' : 'none';
        const emptyCard = document.querySelector('.card.bg-dark');
        if (emptyCard) emptyCard.style.display = algum ? 'none' : '';
      });
    });
  script(src="/javascripts/postagens/show.js")
