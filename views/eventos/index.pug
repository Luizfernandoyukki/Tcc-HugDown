extends ../layout
block styles
  link(rel="stylesheet", href="/stylesheets/eventos/index.css")

block content
  .container.py-5
    h2.mb-4.text-center.text-success.fw-bold
      i.fas.fa-calendar-alt.me-2
      | Eventos

    //- Filtro de meses (carrossel)
    .month-carousel.mb-5.position-relative
      button#month-prev.btn.btn-link.p-0.position-absolute.start-0.top-50.translate-middle-y.shadow-sm.bg-white(type="button", aria-label="Anterior")
        i.fas.fa-chevron-left
      .months-list.d-flex.flex-row.overflow-hidden.align-items-center.bg-light.rounded-pill.shadow-sm(style="scroll-behavior:smooth; min-height:56px;")
        - const meses = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'];
        - const eventosPorMes = {};
        - eventos.forEach(ev => {
        -   const d = new Date(ev.data_inicio);
        -   const key = `${d.getFullYear()}-${(d.getMonth()+1).toString().padStart(2,'0')}`;
        -   if (!eventosPorMes[key]) eventosPorMes[key] = [];
        -   eventosPorMes[key].push(ev);
        - });
        - const mesesComEventos = Object.keys(eventosPorMes).sort();
        - const mesAtual = new Date();
        - let mesSelecionado = typeof selectedMonth !== 'undefined' ? selectedMonth : `${mesAtual.getFullYear()}-${(mesAtual.getMonth()+1).toString().padStart(2,'0')}`;
        each mesKey, idx in mesesComEventos
          - const [ano, mes] = mesKey.split('-');
          .month-pill.mx-1.px-4.py-2.rounded-pill.shadow-sm(
            data-mes=mesKey
            class=(mesKey === mesSelecionado ? 'bg-success text-white fw-bold' : '')
          )
            | #{meses[parseInt(mes)-1]} #{ano}
      button#month-next.btn.btn-link.p-0.position-absolute.end-0.top-50.translate-middle-y.shadow-sm.bg-white(type="button", aria-label="Próximo")
        i.fas.fa-chevron-right

    //- Eventos agrupados por mês
    if eventos.length
      each mesKey in mesesComEventos
        - const [ano, mes] = mesKey.split('-');
        .event-month-section(data-mes=mesKey style=(mesKey === mesSelecionado ? '' : 'display:none;'))
          h4.month-title.mt-5
            i.fas.fa-calendar-day.me-2
            | #{meses[parseInt(mes)-1]} #{ano}
          .row.g-4
            each evento in eventosPorMes[mesKey]
              .col-md-6.col-lg-4
                a.text-decoration-none(href=`/eventos/${evento.id_evento}`)
                  .event-card
                    .card-body
                      .d-flex.align-items-start
                        .event-date-box.me-3
                          .event-day= new Date(evento.data_inicio).getDate().toString().padStart(2, '0')
                          .event-month= meses[new Date(evento.data_inicio).getMonth()]
                        .event-info
                          h5.mb-2= evento.titulo_evento
                          p.text-muted.mb-2
                            i.fas.fa-map-marker-alt.me-2
                            | #{evento.local_evento || 'Online'}
                          .badge.bg-gradient
                            = evento.nome_categoria_evento
    else
      p.text-muted.text-center.mt-5 Nenhum evento encontrado.

    //- Seção: Todos os eventos agrupados por mês
    if eventos.length
      hr.mt-5
      h3.mt-5.mb-4.text-success.text-center.fw-bold
        i.fas.fa-calendar-check.me-2
        | Todos os eventos
      each mesKey in mesesComEventos
        - const [ano, mes] = mesKey.split('-');
        .event-month-section-all.mb-5
          h5.mb-3.text-success.fw-bold
            i.fas.fa-calendar-day.me-2
            | #{meses[parseInt(mes)-1]} #{ano}
          .row.g-4.flex-wrap
            each evento in eventosPorMes[mesKey]
              .col-md-6.col-lg-4
                a(href=`/eventos/${evento.id_evento}` style="text-decoration:none; color:inherit;")
                  .card.mb-4.shadow.event-card.position-relative
                    .card-body.d-flex.align-items-center
                      .event-date-box.me-3.shadow-sm
                        .event-day= new Date(evento.data_inicio).getDate().toString().padStart(2, '0')
                        .event-month= meses[new Date(evento.data_inicio).getMonth()]
                      .flex-grow-1
                        h5.card-title.mb-1.fw-bold.text-success= evento.titulo_evento
                        if evento.data_inicio
                          small.text-muted
                            i.fas.fa-clock.me-1
                            | #{new Date(evento.data_inicio).toLocaleDateString('pt-BR')} - 
                            | #{evento.local_evento || evento.endereco_evento || 'Online'}
                        span.badge.bg-gradient.bg-primary.ms-2(style="font-size:0.95em; background: linear-gradient(90deg,#43e97b 0,#38f9d7 100%); color:#fff;")= evento.nome_categoria_evento
                        p.mt-2.text-muted(style="font-size:1.01em;")= evento.descricao_evento ? evento.descricao_evento.substring(0, 100) + '...' : ''

block scripts
  script.
    // Carrossel de meses
    (function() {
      const meses = Array.from(document.querySelectorAll('.month-pill'));
      const sections = Array.from(document.querySelectorAll('.event-month-section'));
      let idxSelecionado = meses.findIndex(m => m.classList.contains('bg-success'));
      function selecionar(idx) {
        if (idx < 0 || idx >= meses.length) return;
        meses.forEach((el, i) => {
          el.classList.toggle('bg-success', i === idx);
          el.classList.toggle('text-white', i === idx);
          el.classList.toggle('fw-bold', i === idx);
          el.classList.toggle('bg-light', i !== idx);
          el.classList.toggle('text-success', i !== idx);
        });
        sections.forEach((sec, i) => {
          sec.style.display = (i === idx) ? '' : 'none';
        });
        idxSelecionado = idx;
        // Scroll para o mês selecionado ficar visível
        const list = document.querySelector('.months-list');
        if (list && meses[idx]) {
          const el = meses[idx];
          const left = el.offsetLeft - list.offsetLeft;
          list.scrollTo({ left: left - 20, behavior: 'smooth' });
        }
      }
      meses.forEach((el, i) => {
        el.addEventListener('click', () => selecionar(i));
      });
      document.getElementById('month-prev').onclick = () => selecionar(idxSelecionado - 1);
      document.getElementById('month-next').onclick = () => selecionar(idxSelecionado + 1);
      // Responsivo: mostra o mês atual ao carregar
      if (idxSelecionado < 0) selecionar(0);
    })();

