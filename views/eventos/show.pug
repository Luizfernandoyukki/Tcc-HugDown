extends ../layout

block content
  a.btn.btn-outline-secondary.mb-3.d-flex.align-items-center.justify-content-start(style="max-width:120px;" href="javascript:history.back()")
    i.fas.fa-arrow-left.me-2
    | Voltar
  .container.py-5
    if evento
      - const categoria = (evento.nome_categoria_evento || '').toLowerCase();
      - const temas = { 'reuniões': 'cat-reunioes', 'eventos beneficentes': 'cat-beneficentes', 'acessível': 'cat-acessivel', 'festas': 'cat-festas', 'formaturas': 'cat-formaturas', 'outros': 'cat-outros', '': 'cat-sem-categoria', 'sem categoria': 'cat-sem-categoria' };
      - const categoriaClass = temas[categoria] || 'cat-sem-categoria';
      .card.shadow-lg.p-4.mb-5(class=categoriaClass, style="max-width:700px;margin:0 auto;border-radius:18px;")
        .d-flex.align-items-center.mb-3
          .event-date-box.me-4.shadow-sm(style="min-width:70px;")
            .event-day(style="font-size:2.2rem;font-weight:700;")= new Date(evento.data_inicio).getDate().toString().padStart(2, '0')
            - const meses = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'];
            .event-month(style="font-size:1.1rem;font-weight:600;text-transform:uppercase;")= meses[new Date(evento.data_inicio).getMonth()]
          .flex-grow-1
            h2.mb-1.fw-bold= evento.titulo_evento
            .mb-2
              span.badge.badge-categoria.me-2(class=categoriaClass)= evento.nome_categoria_evento || 'Sem categoria'
              span.badge.bg-secondary.me-2
                if evento.tipo_evento === 'online'
                  i.fas.fa-globe.me-1
                  | Online
                else if evento.tipo_evento === 'hybrid'
                  i.fas.fa-exchange-alt.me-1
                  | Híbrido
                else
                  i.fas.fa-map-marker-alt.me-1
                  | Presencial
            small.text-muted
              i.fas.fa-clock.me-1
              | #{new Date(evento.data_inicio).toLocaleString('pt-BR')}
              if evento.data_fim
                |  até #{new Date(evento.data_fim).toLocaleString('pt-BR')}
            br
            // endereço + link para Google Maps (mantém o texto do endereço)
            - const endereco = enderecoCompleto || evento.local_evento || evento.endereco_evento;
            small.text-muted
              i.fas.fa-map-marker-alt.me-1
              | Local:
              span.ms-1= endereco || 'Online'
              if endereco
                |  
                - const gHref = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(endereco);
                a.ms-2(href=gHref, target="_blank", rel="noopener noreferrer")
                  i.fab.fa-google.me-1
                  | Ver no Maps
            if evento.max_participantes
              br
              small.text-muted
                i.fas.fa-users.me-1
                | Máx. participantes: #{evento.max_participantes}
            if evento.organizador
              br
              small.text-muted
                i.fas.fa-user.me-1
                | Organizador: #{evento.organizador.nome_usuario}
            if evento.link_online
              .mb-3
                label.text-muted Link do Evento Online:
                a(href=evento.link_online, target="_blank", rel="noopener noreferrer")= evento.link_online
        hr
        p.mt-3(style="font-size:1.08em; color:#444;")= evento.descricao_evento

        // Participação
        if isLoggedIn
          if usuarioJaInscrito
            div.alert.alert-success.mt-4 Você já está inscrito neste evento.
          else
            form(method="post", action=`/eventos/${evento.id_evento}/participar`)
              button.btn.btn-success.mt-4(type="submit" style="font-size:1.1em; padding:0.7em 2.5em; border-radius:8px;") Participar do evento
        else
          div.alert.alert-warning.mt-4
            | Faça login para participar deste evento.

        // Botão de reportar evento
        button.btn.btn-outline-danger.mt-3(data-bs-toggle="modal", data-bs-target="#modalReportEvento")
          i.fas.fa-flag.me-2
          | Reportar Evento

    else
      p.text-danger.text-center.mt-5 Evento não encontrado.

    // Modal de report
    .modal.fade#modalReportEvento(tabindex="-1", aria-labelledby="modalReportEventoLabel", aria-hidden="true")
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title#modalReportEventoLabel Reportar Evento
            button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Fechar")
          .modal-body
            form#formReportEvento(method="POST", action=`/eventos/${evento.id_evento}/report`)
              input(type="hidden", name="id_evento", value=evento.id_evento)
              .mb-3
                label(for="motivo") Motivo
                select.form-select(name="motivo", id="motivo", required)
                  option(value="spam") Spam
                  option(value="conteudo_inadequado") Conteúdo inadequado
                  option(value="outro") Outro
              .mb-3
                label(for="detalhes") Detalhes
                textarea.form-control(name="detalhes", id="detalhes", rows="3")
              button.btn.btn-danger(type="submit") Enviar Report

