extends ../layout

block styles
  link(rel="stylesheet", href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css")
  link(rel="stylesheet", href="/stylesheets/eventos/create.css")
  style.
    /* Estilo extra para o formulário de evento */
    #form-criar-evento {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 2px 16px #0001;
      padding: 2rem 2.5rem;
      max-width: 700px;
      margin: 0 auto;
    }
    #form-criar-evento h2 {
      color: #198754;
      font-weight: 700;
      margin-bottom: 2rem;
    }
    #form-criar-evento label {
      font-weight: 500;
      color: #198754;
    }
    #form-criar-evento .form-control, #form-criar-evento .form-select {
      border-radius: 8px;
      border: 1px solid #19875433;
      font-size: 1.05rem;
    }
    #form-criar-evento button[type="submit"] {
      background: linear-gradient(90deg, #198754 60%, #43e97b 100%);
      border: none;
      font-weight: 600;
      font-size: 1.1rem;
      padding: 0.7rem 2.5rem;
      border-radius: 8px;
      box-shadow: 0 2px 8px #19875422;
      transition: background 0.2s;
    }
    #form-criar-evento button[type="submit"]:hover {
      background: linear-gradient(90deg, #43e97b 60%, #198754 100%);
    }

block content
  .container.py-5
    h2.mb-4 Criar Evento

    form(method="post", action="/eventos", id="form-criar-evento")
      .mb-3
        label.form-label(for="titulo_evento") Título do Evento *
        input.form-control(type="text", name="titulo_evento", id="titulo_evento", required)

      .mb-3
        label.form-label(for="descricao_evento") Descrição
        textarea.form-control(name="descricao_evento", id="descricao_evento", rows="3")

      .row
        .col-md-6.mb-3
          label.form-label(for="data_inicio") Data e Hora de Início *
          input.form-control(type="datetime-local", name="data_inicio", id="data_inicio", required)
        .col-md-6.mb-3
          label.form-label(for="data_fim") Data e Hora de Fim
          input.form-control(type="datetime-local", name="data_fim", id="data_fim")

      .mb-3
        label.form-label Localização do Evento *
        #map(style="height: 350px; border-radius: 10px; margin-bottom: 10px;")
        small.text-muted Clique no mapa para escolher o local do evento.

      .row
        .col-md-6.mb-3
          label.form-label(for="local_evento") Local (nome do local, sala, etc)
          input.form-control(type="text", name="local_evento", id="local_evento")
        .col-md-6.mb-3
          label.form-label(for="tipo_evento") Tipo de Evento *
          select.form-select(name="tipo_evento", id="tipo_evento", required)
            option(value="in_person") Presencial
            option(value="online") Online
            option(value="hybrid") Híbrido

      .mb-3
        label.form-label(for="link_online") Link do Evento Online
        input.form-control(type="url", name="link_online", id="link_online" placeholder="https://...")

      .row
        .col-md-6.mb-3
          label.form-label(for="nome_categoria_evento") Categoria *
          select.form-select(name="nome_categoria_evento", id="nome_categoria_evento", required)
            option(value="") Selecione...
            option(value="Reuniões") Reuniões
            option(value="Eventos beneficentes") Eventos beneficentes
            option(value="Acessível") Acessível
            option(value="Festas") Festas
            option(value="Formaturas") Formaturas
            option(value="Outros") Outros
        .col-md-6.mb-3
          label.form-label(for="max_participantes") Máximo de Participantes
          input.form-control(type="number", name="max_participantes", id="max_participantes", min="1")

      // Campos ocultos para latitude/longitude
      input(type="hidden", name="latitude", id="latitude", required)
      input(type="hidden", name="longitude", id="longitude", required)
      input(type="hidden", name="endereco_evento", id="endereco_evento")

      button.btn.btn-primary.mt-3(type="submit") Criar Evento

block scripts
  // Adicione Leaflet.js e o script customizado
  script(src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js")
  script(src="/javascripts/eventos/create.js")
  script.
    // Restrição: Data de início só pode ser 2 dias após agora
    document.addEventListener('DOMContentLoaded', function() {
      var dataInicio = document.getElementById('data_inicio');
      var dataFim = document.getElementById('data_fim');
      if (dataInicio) {
        var now = new Date();
        now.setDate(now.getDate() + 2);
        var minDate = now.toISOString().slice(0,16);
        dataInicio.min = minDate;
        dataInicio.addEventListener('input', function() {
          if (dataInicio.value < minDate) {
            dataInicio.setCustomValidity('A data de início deve ser pelo menos 2 dias após hoje.');
          } else {
            dataInicio.setCustomValidity('');
          }
          // Atualiza o min do data_fim sempre que data_inicio mudar
          if (dataFim) {
            dataFim.min = dataInicio.value;
            if (dataFim.value && dataFim.value < dataInicio.value) {
              dataFim.value = '';
            }
          }
        });
      }
      // Também impede submit se data_fim < data_inicio
      var form = document.getElementById('form-criar-evento');
      if (form && dataInicio && dataFim) {
        form.addEventListener('submit', function(e) {
          if (dataFim.value && dataFim.value < dataInicio.value) {
            e.preventDefault();
            alert('A data de fim não pode ser anterior à data de início do evento.');
            dataFim.focus();
          }
        });
      }
    });