extends layout

block styles
  link(rel="stylesheet", href="/stylesheets/auth.css")

block content
  a.btn.btn-outline-secondary.mb-3.d-flex.align-items-center.justify-content-start(style="max-width:120px;" href="javascript:history.back()")
    i.fas.fa-arrow-left.me-2
    | Voltar
  .auth-container
    .auth-card
      i.fas.fa-lock.auth-icon
      h2.auth-title Acesso Restrito
      p.auth-message #{mensagem || 'Esta área requer autenticação. Por favor, faça login para continuar.'}
      
      a.btn.btn-primary.auth-button(href=redirectUrl || '/login')
        i.fas.fa-sign-in-alt.me-2
        | Fazer Login

      if redirectUrl && redirectUrl !== '/login'
        p.mt-3.text-muted Você será redirecionado após o login.
