extends layout

block content
  link(rel="stylesheet", href="/stylesheets/feed.css")
  script(src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js")

  // Fundo do feed com degradê verde
  .feed-bg
    .feed-container
      // Topo: Categorias e Tags
      .top-bar
        .categorias
          // Botão para mostrar todas as postagens
          button.btn.btn-success.categoria-btn(data-categoria="" style="background:#009e60;") Todas
          each categoria in categorias
            button.btn.btn-success.categoria-btn(data-categoria=categoria.id_categoria)= categoria.nome_categoria
        .tags-scroll
          .tags-list
            each tag, i in tags
              if i < 10
                button.btn.btn-light.tag-btn(data-tag=tag.id_tag)= tag.nome_tag
            if tags.length > 10
              button.btn.btn-secondary#mostrar-todas-tags Mostrar todas

      // Menu lateral de tags (oculto por padrão)
      .menu-lateral-tags#menu-lateral-tags
        h4 Todas as Tags
        each tag in tags
          button.btn.btn-light.tag-btn(data-tag=tag.id_tag)= tag.nome_tag
        button.btn.btn-dark#fechar-menu-lateral Fechar

      // Mensagem de boas-vindas
      .bem-vindo
        if usuario
          h2 Bem-vindo, #{usuario.nome_usuario}!
        else
          h2 Bem-vindo!

      // Feed de postagens
      .posts-feed
        each post in posts
          if post && post.id_postagem && post.autor && post.titulo
            .card-postagem(data-id=post.id_postagem data-id-autor=post.autor.id_usuario)
              // Só mostra o botão reportar se o post tem id_postagem e autor
              if post.id_postagem && post.autor
                button.btn.btn-outline-danger.reportar-btn(title="Reportar postagem") Reportar
              .autor-info
                a(href='/usuarios/show/' + post.autor.id_usuario, title='Perfil do autor')
                  img.foto-autor(
                    src=post.autor.foto_perfil && post.autor.foto_perfil.startsWith('/') ? post.autor.foto_perfil : ('/perfis/' + (post.autor.foto_perfil || 'default-avatar.png')),
                    alt="Foto do autor"
                  )
                  span.nome-autor @#{post.autor.nome_usuario}
              h3.titulo-post= post.titulo
              .resumo-post= post.resumo
              .datas-post
                span Data de criação:
                span= post.data_criacao ? new Date(post.data_criacao).toLocaleString('pt-BR') : ''
                if post.data_atualizacao
                  span Atualizado em:
                  span= post.data_atualizacao ? new Date(post.data_atualizacao).toLocaleString('pt-BR') : ''
                if post.endereco
                  span Localização:
                  span= post.endereco
              if post.conteudo
                .conteudo-post= post.conteudo
              if post.url_midia
                img.foto-post(src=post.url_midia, alt="Foto da postagem")
              // Rodapé do card: botões e contadores
              .card-footer.d-flex.justify-content-between.align-items-center(style="background:transparent;border:none;padding:0;margin-top:1rem;")
                .acoes-post.d-flex.gap-2
                  button.btn.btn-danger.curtir-btn(data-id=post.id_postagem)
                    i.fa.fa-heart(style="color:#e74c3c;")
                    | Curtir
                  button.btn.btn-success.comentar-btn(data-id=post.id_postagem)
                    i.fa.fa-comment(style="color:#27ae60;")
                    | Comentários
                .contadores.d-flex.align-items-center.gap-3
                  .curtidas-indicador.d-flex.align-items-center
                    i.fa.fa-heart(style="color:#e74c3c;font-size:1.2rem;")
                    span.curtidas-count(style="margin-left:4px;")= post.curtidas || 0
                  .visualizacoes-indicador.d-flex.align-items-center
                    i.fa.fa-wifi(style="color:#007bff;font-size:1.2rem;")
                    span(style="margin-left:4px;")= post.visualizacoes || 0

      .comentarios-aba#comentarios-aba
        .comentarios-list-aba
          // Comentários serão carregados via JS
        form.comentar-form-aba
          textarea(name="conteudo" placeholder="Digite seu comentário...")
          button.btn.btn-success(type="submit") Enviar

  script(src="/javascripts/feed.js", defer)