extends layout

block content
  section.feed-section.py-5
    .container.d-flex.justify-content-center
      .feed-wrapper(style="width:60%;margin:auto;")
        h2.mb-4.text-center Feed de Postagens

        // Balões de categorias
        .mb-3.d-flex.justify-content-center
          .d-flex.flex-wrap.gap-2
            each cat in categorias.slice(0,4)
              .badge.bg-primary.text-light.px-3.py-2.fs-6(style="cursor:pointer" onclick=`window.location='?categoria=${cat.id_categoria}'`)
                i.fas.fa-folder-open.me-1
                | #{cat.nome_categoria}

        // Balões de tags (limitadas, botão para expandir)
        .mb-3.d-flex.justify-content-center
          .d-flex.flex-wrap.gap-2#tags-baloes
            each tg, idx in tags
              if idx < 8
                .badge.bg-secondary.text-light.px-3.py-2.fs-6.tag-balao(style="cursor:pointer" onclick=`window.location='?tag=${tg.id_tag}'`)
                  i.fas.fa-tag.me-1
                  | #{tg.nome_tag}
          button.btn.btn-outline-secondary.btn-sm.ms-2#btn-exibir-todas-tags(type="button") Exibir todas

        // Lista de postagens
        .row.mt-4.justify-content-start
          if posts.length === 0
            .col-12
              p.text-muted.text-center Nenhuma postagem encontrada.
          else
            each post, idx in posts
              .col-12.mb-5 
                .card.shadow-sm.mx-auto(style="max-width:100%; text-align:left;")
                  .card-body
                    .d-flex.align-items-center.mb-2
                      if post.autor && post.autor.foto_perfil
                        img.rounded-circle.me-2(src=post.autor.foto_perfil, alt="Foto perfil", width="40", height="40")
                      else
                        img.rounded-circle.me-2(src="/images/default-profile.png", alt="Foto perfil", width="40", height="40")
                      .flex-grow-1
                        h6.mb-0 #{post.autor ? post.autor.nome_usuario : 'Autor desconhecido'}
                        small.text-muted #{post.data_criacao ? post.data_criacao.toLocaleString() : ''}
                    h5.card-title.mt-2 #{post.titulo}
                    .d-flex.mb-2
                      if post.categoria
                        span.badge.bg-primary.me-1 #{post.categoria.nome_categoria}
                      if post.tag
                        span.badge.bg-secondary.me-1 #{post.tag.nome_tag}
                    if post.endereco
                      small.text-muted.d-block.mb-1 Endereço: #{post.endereco}
                    if post.url_midia
                      .d-flex.justify-content-start
                        img.mt-2.mb-2(src=post.url_midia, alt="Imagem da postagem", style="max-width:100%;max-height:200px;")
                    else
                      if post.resumo
                        p.card-text.text-muted #{post.resumo}
                      p.mb-2 #{post.conteudo}
                    .d-flex.gap-2.align-items-center
                      button.btn.btn-outline-danger.btn-sm.btn-curtir(type="button" data-id=post.id_postagem data-idx=idx)
                        i.fas.fa-heart.me-1
                        | Curtir
                        span.ms-1.curtidas-count(id=`curtidas-count-${post.id_postagem}`) #{post.curtidas || 0}
                      button.btn.btn-outline-primary.btn-sm.btn-comentar(type="button" data-id=post.id_postagem)
                        i.fas.fa-comment.me-1
                        | Comentar
                      button.btn.btn-outline-success.btn-sm.btn-compartilhar(type="button" data-id=post.id_postagem)
                        i.fas.fa-share.me-1
                        | Compartilhar
                      button.btn.btn-outline-dark.btn-sm.btn-expandir(type="button" style="margin-left:auto;" data-idx=idx)
                        i.fas.fa-expand.me-1
                        | Expandir

        // Modal para expandir postagem
        .modal.fade#modalPostagem(tabindex="-1")
          .modal-dialog.modal-lg
            .modal-content
              .modal-header
                h5.modal-title#modalTitulo
                button.btn-close(type="button" data-bs-dismiss="modal")
              .modal-body
                // Conteúdo dinâmico
                #modalConteudo
              .modal-footer
                button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Fechar

      // Exporta os dados das postagens para o JS
      script.
        window.postsData = !{JSON.stringify(posts)};

block scripts
  script(src="/javascripts/feed.js")
