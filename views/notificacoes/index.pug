extends ../layout

block styles
  link(rel="stylesheet", href="/stylesheets/notificacoes/index.css")

block content
  .container.mt-4
    h2.d-flex.align-items-center
      i.fas.fa-bell.me-3.text-success
      | Minhas Notificações
    
    if notificacoes.length === 0
      p.text-muted.empty-state
        i.fas.fa-inbox.d-block.mb-3.fa-2x
        | Nenhuma notificação encontrada.
    else
      .mb-3
        label.form-label(for="filtroTipoNotificacao") Filtrar por tipo:
        select.form-select#filtroTipoNotificacao
          option(value="") Todas
          option(value="friendship") Pedidos de amizade
          option(value="advertencia") Advertências
          option(value="like") Curtidas
          option(value="comment") Comentários
          option(value="event") Eventos
          option(value="system") Sistema
      ul.list-group#lista-notificacoes
        each n in notificacoes
          li.list-group-item.d-flex.flex-wrap(data-tipo=n.tipo_notificacao class=n.lida ? '' : 'list-group-item-warning')
            .notification-content
              strong= n.titulo
              span.text-muted= n.mensagem
              small.text-muted
                i.far.fa-clock.me-1
                = new Date(n.data_criacao).toLocaleString('pt-BR')
            .notification-actions
              if n.tipo_notificacao === 'friendship' && !n.lida && n.id_amizade
                form.d-inline-block.me-2(action=`/amizades/${n.id_amizade}/aceitar`, method="POST")
                  button.btn.btn-sm.btn-success(type="submit")
                    i.fas.fa-check.me-1
                    | Aceitar
                form.d-inline-block(action=`/amizades/${n.id_amizade}/recusar`, method="POST")
                  button.btn.btn-sm.btn-danger(type="submit")
                    i.fas.fa-times.me-1
                    | Recusar
              else if n.tipo_notificacao === 'group_invite' && !n.lida && n.id_grupo
                form.d-inline-block.me-2(action=`/grupos/${n.id_grupo}/aceitar-convite`, method="POST")
                  button.btn.btn-sm.btn-success(type="submit")
                    i.fas.fa-check.me-1
                    | Aceitar
                form.d-inline-block(action=`/grupos/${n.id_grupo}/recusar-convite`, method="POST")
                  button.btn.btn-sm.btn-danger(type="submit")
                    i.fas.fa-times.me-1
                    | Recusar
              else if !n.lida
                form.d-inline-block(action=`/notificacoes/${n.id_notificacao}/ler` method="POST")
                  button.btn.btn-sm.btn-outline-success(type="submit")
                    i.fas.fa-check.me-1
                    | Marcar como lida
    script.
      document.getElementById('filtroTipoNotificacao').addEventListener('change', function() {
        const tipo = this.value;
        document.querySelectorAll('#lista-notificacoes li').forEach(li => {
          if (!tipo || li.getAttribute('data-tipo') === tipo) {
            li.style.display = '';
          } else {
            li.style.display = 'none';
          }
        });
      });
