doctype html
html
  head
    title= HugDown
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    // Bootstrap CSS CDN
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css', crossorigin='anonymous')
    link(rel='stylesheet', href='/stylesheets/geral.css')
    link(rel='stylesheet', href='/stylesheets/layout.css')
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    block styles
  body
    // Navbar Bootstrap
    nav.navbar.navbar-expand-lg.navbar-light.bg-light.shadow-sm.py-0
      .container-fluid
        a.navbar-brand.d-flex.align-items-center.gap-2(href='/')
          img#logo-hugdown.logo-hugdown(src='/images/logo.png', alt='HugDown Logo', height='80')
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarNav')
          span.navbar-toggler-icon
        .collapse.navbar-collapse#navbarNav
          // Barra de pesquisa com ícone
          form.d-flex.mx-auto.search-box
            input.search-input(type="search", placeholder="Pesquisar...", aria-label="Search")
            button.search-button(type="submit", title="Pesquisar")
              i.fas.fa-search
          // força layout horizontal e center para itens do nav
          ul.navbar-nav.ms-auto.flex-row.align-items-center.gap-3
            li.nav-item.notification-wrapper.position-relative
              a.nav-link.p-2.acao-restrita(href='/notificacoes', title='Notificações')
                img#icon-notificacao.menu-icon(src='/images/notificação.png', alt='Notificações')
                .notification-indicator.position-absolute.top-0.end-0.bg-danger.rounded-circle(style="width:18px;height:18px;z-index:2;")
                  // Este elemento será preenchido via JS com o número de notificações não lidas
            li.nav-item
              a.nav-link.p-2.acao-restrita(href='/postagens', title='Nova postagem')
                img#icon-mais.menu-icon(src='/images/mais.png', alt='Nova postagem')

    // Conteúdo principal
    main.site-main.container.mt-4.mb-5
      block content

    // Rodapé Bootstrap
    footer.site-footer.bg-light.shadow-sm
      // usa 'usuario' (res.locals.usuario) que é setado globalmente
      if isLoggedIn && usuario
        .container
          .row.align-items-center.justify-content-between
            .col-6.d-flex.align-items-center
              a.d-flex.align-items-center(href='/usuarios/index/' + usuario.id_usuario, title='Meu Perfil')
                img.rounded-circle(
                  src= usuario.foto_perfil && usuario.foto_perfil.startsWith('/') ? usuario.foto_perfil : (usuario.foto_perfil ? ('/perfis/' + usuario.foto_perfil) : '/images/default-avatar.png'),
                  alt='Perfil',
                  height='48'
                )
            .col-6.d-flex.align-items-center.justify-content-end
              a.d-flex.align-items-center(href='/mensagens-diretas', title='Mensagens')
                img.footer-icon(src='/images/chat.png', alt='Mensagens')

    // Scripts
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script.
      // garante que 'walker' existe para evitar ReferenceError em layout.js
      window.walker = window.walker || null;
    script.
      // variáveis globais: booleano e id (compatível com código existente)
      window.usuarioLogado = !{JSON.stringify(!!isLoggedIn)};
      window.usuarioLogadoId = !{usuario ? usuario.id_usuario : null};
    script(src='/javascripts/geral.js')
    script(src='/javascripts/layout.js')
    script(src='/javascripts/search.js')
    if blokdepalavroesJs
      script(src=blokdepalavroesJs)
    block scripts
      script(src=blokdepalavroesJs)
    block aviso
  block aviso
  block scripts
  block aviso
  block scripts
  block aviso
  block scripts
  block aviso
  block scripts
  block aviso
  block aviso
  block scripts
  block aviso
  block scripts
  block aviso
