extends ../layout

block styles
  link(rel="stylesheet", href="/stylesheets/usuarios/index.css")

block content
  .container.mt-4
    .row
      .col-md-4
        .card.shadow-sm.mb-4
          .card-body.text-center
            if usuario.foto_perfil
              img.rounded-circle.mb-3(src=usuario.foto_perfil, alt=usuario.nome_usuario, width="120", height="120")
            h4
              = usuario.nome_usuario
              if usuario.verificado
                span.ms-2.text-success(title="Usuário verificado")
                  i.fas.fa-check-circle
              if usuario.profissionalSaude
                span.ms-2.text-primary(title="Profissional de Saúde")
                  i.fas.fa-user-md
              // Ícone de configurações
              a.ms-2.text-secondary(href=`/usuarios/configuracoes`, title="Configurações")
                i.fas.fa-cog
            p.text-muted= usuario.email
            if usuario.biografia
              p.mt-2= usuario.biografia
            ul.list-unstyled.mt-3
              li
                b Nome real: 
                | #{usuario.nome_real} #{usuario.sobrenome_real}
              li
                b Localização: 
                | #{usuario.cidade}, #{usuario.estado}, #{usuario.pais}
            a.btn.btn-warning.mt-3(href=`/usuarios/edit/${usuario.id_usuario}`) Editar perfil
            a.btn.btn-primary.mt-2(href="/amizades") Procurar usuários
            // Botão para abrir modal de pedidos de amizade
            button.btn.btn-info.mt-2(type="button", id="btn-pedidos-amizade") Pedidos de amizade
        // Modal de pedidos de amizade
        .modal.fade#modal-pedidos-amizade(tabindex="-1", aria-labelledby="modalPedidosLabel", aria-hidden="true")
          .modal-dialog
            .modal-content
              .modal-header
                h5.modal-title#modalPedidosLabel Pedidos de amizade
                button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Fechar")
              .modal-body
                // Lista de pedidos será preenchida via JS
                ul.list-group#lista-pedidos-amizade
                  li.list-group-item.text-muted Carregando...
              .modal-footer
                button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Fechar
        // Botão de logout no canto inferior esquerdo
        .mt-4
          form(action="/logout", method="POST")
            button.btn.btn-outline-danger.w-100(type="submit") Logout
      .col-md-8
        .card.shadow-sm
          .card-body
            h5.text-primary.mb-3 Minhas Postagens
            if usuario.postagens && usuario.postagens.length
              each post in usuario.postagens
                .card.mb-3
                  .card-body
                    if post.url_midia
                      img.img-fluid.mb-2(src=post.url_midia, alt=post.titulo, style="max-width:100%;height:auto;", onerror="this.src='/images/default-post.png'")
                    h6= post.titulo || 'Sem título'
                    p.text-muted= post.resumo || ''
                    small.text-muted
                      | Criado em: #{post.data_criacao ? (post.data_criacao.toLocaleString ? post.data_criacao.toLocaleString() : post.data_criacao) : 'N/A'}
            else
              p.text-muted Nenhuma postagem encontrada.

block scripts
  script(src="/javascripts/usuarios/index.js")
    window.usuario = !{JSON.stringify(usuario)};
  script(src="/blokdepalavroes.js")

