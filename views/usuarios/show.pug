extends ../layout

block styles
  link(rel="stylesheet", href="/stylesheets/usuarios/show.css")

block content
  if !usuario
    .alert.alert-danger.mt-4 Usuário não encontrado.
  else
    .container.mt-4
      .row
        .col-md-4
          .card.shadow-sm.mb-4
            .card-body.text-center
              if usuario.foto_perfil
                img.rounded-circle.mb-3(src=usuario.foto_perfil, alt=usuario.nome_usuario, width="120", height="120", onerror="this.src='/images/default-user.png'")
              h4= usuario.nome_usuario
              p.text-muted= usuario.email
              if usuario.biografia
                p.mt-2= usuario.biografia
              ul.list-unstyled.mt-3
                li
                  b Nome real: 
                  | #{usuario.nome_real} #{usuario.sobrenome_real}
                li
                  b Localização: 
                  | #{usuario.cidade}, #{usuario.estado}, #{usuario.pais}
              // Botão de amizade
              if !(!locals.usuario || usuario.id_usuario === locals.usuario.id_usuario)
                // Só mostra se não for o próprio perfil
                form(action=`/amizades/solicitar` method="POST")
                  input(type="hidden" name="id_destinatario" value=usuario.id_usuario)
                  if usuario.status_amizade === 'pending'
                    button.btn.btn-secondary.mt-2(type="button" disabled) Solicitação pendente
                  else if usuario.status_amizade === 'accepted'
                    button.btn.btn-success.mt-2(type="button" disabled) Amizade aceita
                  else if usuario.status_amizade === 'rejected'
                    button.btn.btn-danger.mt-2(type="button" disabled) Solicitação rejeitada
                  else if usuario.status_amizade === 'blocked'
                    button.btn.btn-dark.mt-2(type="button" disabled) Usuário bloqueado
                  else
                    button.btn.btn-primary.mt-2(type="submit") Enviar solicitação de amizade
              // Botão de denunciar perfil (não atrapalha layout)
              if !(!locals.usuario || usuario.id_usuario === locals.usuario.id_usuario)
                button.btn.btn-outline-danger.mt-2.ms-2(type="button", data-bs-toggle="modal", data-bs-target="#modalDenunciarPerfil")
                  i.fas.fa-flag.me-1
                  | Denunciar Perfil
            // Modal de denúncia de perfil
            .modal.fade#modalDenunciarPerfil(tabindex="-1", aria-labelledby="modalDenunciarPerfilLabel", aria-hidden="true")
              .modal-dialog
                .modal-content
                  .modal-header
                    h5.modal-title#modalDenunciarPerfilLabel Denunciar Perfil
                    button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Fechar")
                  .modal-body
                    form(action="/admin/super/usuarios/reportar", method="POST")
                      input(type="hidden", name="id_usuario", value=usuario.id_usuario)
                      .mb-3
                        label(for="motivo") Motivo
                        select.form-select(name="motivo", id="motivo", required)
                          option(value="spam") Spam
                          option(value="conteudo_inadequado") Conteúdo inadequado
                          option(value="outro") Outro
                      .mb-3
                        label(for="detalhes") Detalhes
                        textarea.form-control(name="detalhes", id="detalhes", rows="3")
                      button.btn.btn-danger(type="submit") Enviar denúncia
            .card.shadow-sm.mb-4
              .card-body
                h5.text-success.mb-3 Amigos
                if usuario.amigos && usuario.amigos.length
                  .d-flex.flex-wrap
                    each amigo in usuario.amigos
                      .me-2.mb-2
                        img.rounded-circle(src=amigo.foto_perfil, alt=amigo.nome_usuario, width="40", height="40", onerror="this.src='/images/default-user.png'")
                        span.ms-2= amigo.nome_usuario
                else
                  p.text-muted Nenhum amigo encontrado.
        .col-md-8
          .card.shadow-sm
            .card-body
              h5.text-primary.mb-3 Postagens de #{usuario.nome_usuario}
              if usuario.postagens && usuario.postagens.length
                each post in usuario.postagens
                  .card.mb-3
                    .card-body
                      if post.url_midia
                        img.img-fluid.mb-2(src=post.url_midia, alt=post.titulo, style="max-width:100%;height:auto;", onerror="this.src='/images/default-post.png'")
                      h6= post.titulo || 'Sem título'
                      p.text-muted= post.resumo || ''
                      small.text-muted
                        | Criado em: #{post.data_criacao ? (post.data_criacao.toLocaleString ? post.data_criacao.toLocaleString() : post.data_criacao) : 'N/A'}
              else
                p.text-muted Nenhuma postagem encontrada.

block scripts
  script.
    window.usuarioData = !{JSON.stringify(usuario)};
    console.log('[FRONTEND] Dados do perfil visualizado:', window.usuarioData);
  script(src="/javascripts/usuarios/show.js")
