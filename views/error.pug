extends layout

block styles
  link(rel="stylesheet", href="/stylesheets/error.css")

block content
  .error-container
    .error-content
      if error.status === 404
        i.fas.fa-search.error-icon
        h1.error-title Página não encontrada
        p.error-message A página que você está procurando não existe ou foi movida.
      else if error.status === 403
        i.fas.fa-lock.error-icon
        h1.error-title Acesso negado
        p.error-message Você não tem permissão para acessar esta página.
      else
        i.fas.fa-exclamation-circle.error-icon
        h1.error-title Ops! Algo deu errado
        p.error-message Desculpe pelo inconveniente. Nossa equipe foi notificada.

        // Bloco de depuração: mostra erro detalhado se existir
        if error && error.message
          .error-debug-box(style="background:#f8d7da;color:#721c24;padding:1rem;border-radius:8px;margin-top:24px;")
            h4 Erro Interno (Debug)
            p
              b Mensagem:
              | #{error.message}
            if error.stack
              pre(style="white-space:pre-wrap;font-size:0.9em;") #{error.stack}
            if error.type
              p
                b Tipo:
                | #{error.type}
            if error.status
              p
                b Status:
                | #{error.status}
            // Mostra o objeto completo se for útil
            if error
              pre(style="white-space:pre-wrap;font-size:0.8em;") #{JSON.stringify(error, null, 2)}

      .error-actions
        a.btn.btn-primary(href="/")
          i.fas.fa-home.me-2
          | Voltar para página inicial
        a.btn.btn-outline-primary(href="javascript:history.back()")
          i.fas.fa-arrow-left.me-2
          | Voltar
