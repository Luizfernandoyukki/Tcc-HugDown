extends ../layout

block styles
  link(rel="stylesheet", href="/stylesheets/admin/super.css")

block content
  .container.mt-4
    #admin-msg-box(style="display:none;") // Mensagens do painel admin aparecem aqui
    // Estatísticas
    .row
      .col-md-4
        .stats-card
          .stats-number #{usuarios ? usuarios.length : 0}
          .stats-label Usuários Totais
      .col-md-4
        .stats-card
          .stats-number #{postagens ? postagens.length : 0}
          .stats-label Postagens Totais
      .col-md-4
        .stats-card
          .stats-number #{docsVerificacao ? docsVerificacao.length : 0}
          .stats-label Documentos de Verificação Pendentes

    // Usuários
    h2.mt-4 Usuários
    .search-box
      input.form-control#userSearch(type="text", placeholder="Buscar usuários...")
    .table-scroll(style="max-height:260px; overflow:auto;")
      table.table.table-striped
        thead
          tr
            th ID
            th Nome
            th Email
            th Advertências
            th Ações
        tbody(id="usuariosTable")
          each usuario in usuarios
            tr
              td= usuario.id_usuario
              td= usuario.nome_usuario || ''
              td= usuario.email || ''
              td
                span.badge.bg-warning(data-id=usuario.id_usuario)= usuario.advertenciasCount || 0
              td
                .btn-group
                  if usuario.bloqueado === true || usuario.bloqueado === 1
                    button.btn.btn-danger.btn-sm(
                      type="button",
                      class="btn-desbanir",
                      data-id=usuario.id_usuario
                    ) Desbanir
                  else
                    button.btn.btn-dark.btn-sm(
                      type="button",
                      class="btn-banir",
                      data-id=usuario.id_usuario
                    ) Banir
                  button.btn.btn-warning.btn-sm(
                    type="button",
                    class="btn-advertir",
                    data-id=usuario.id_usuario,
                    data-nome=usuario.nome_usuario
                  ) Advertir

    // Postagens
    h2.mt-5 Postagens
    .search-box
      input.form-control#postSearch(type="text", placeholder="Buscar postagens...")
    .table-scroll(style="max-height:260px; overflow:auto;")
      table.table.table-striped
        thead
          tr
            th ID
            th Autor
            th Título
            th Ações
        tbody(id="postagensTable")
          each post in postagens
            tr
              td= post.id_postagem
              td= post.id_autor
              td
                a(href="#", data-id=post.id_postagem) #{post.titulo}
      
    // Modal Advertir
    div#modalAdvertir.modal(style="display:none;")
      div.modal-dialog
        div.modal-content
          div.modal-header
            h5.modal-title Advertir Usuário
            button(type="button", class="close btn-close-modal", data-target="modalAdvertir") &times;
          div.modal-body
            p#modalAdvertirNome
            select.form-select#modalAdvertirMotivo
              option(value="Spam") Spam
              option(value="Conteúdo impróprio") Conteúdo impróprio
              option(value="Assédio") Assédio
              option(value="Outro") Outro
            textarea.form-control#modalAdvertirMsg(rows="3" placeholder="Detalhes (opcional)")
          div.modal-footer
            button.btn.btn-secondary(type="button", class="btn-cancel-advertir", data-target="modalAdvertir") Cancelar
            button.btn.btn-warning(type="button", id="btn-enviar-advertencia") Enviar Advertência

    // Modal Banir/Desbanir
    div#modalBanir.modal(style="display:none;")
      div.modal-dialog
        div.modal-content
          div.modal-header
            h5.modal-title#modalBanirTitulo Banir/Desbanir Usuário
            button(type="button", class="close btn-close-modal", data-target="modalBanir") &times;
          div.modal-body
            p#modalBanirNome
            select.form-select#modalBanirMotivoSelect
              option(value="Ofensa grave") Ofensa grave
              option(value="Spam") Spam
              option(value="Conteúdo impróprio") Conteúdo impróprio
              option(value="Excesso de advertências") Excesso de advertências
              option(value="Outro") Outro
            textarea.form-control#modalBanirMotivo(rows="3" placeholder="Detalhes do motivo")
          div.modal-footer
            button.btn.btn-secondary(type="button", class="btn-cancel-banir", data-target="modalBanir") Cancelar
            button.btn.btn-dark(type="button", id="btn-enviar-banir") Confirmar

    // Seção de Verificações
    h2.mt-5
      i.fas.fa-check-circle.mr-2
      | Pedidos de Verificação
    div(style="margin-bottom:32px;")
      table.table.table-striped
        thead
          tr
            th ID
            th Usuário
            th Tipo Documento
            th Instituição
            th Status
            th Arquivo
            th Aprovar
            th Rejeitar
        tbody
          if docsVerificacao && docsVerificacao.length
            each doc in docsVerificacao
              tr
                td= doc.id_documento
                td= doc.usuario && doc.usuario.nome_usuario ? doc.usuario.nome_usuario : doc.id_usuario
                td= doc.tipo_documento
                td= doc.instituicao
                td= doc.status
                td
                  if doc.caminho_arquivo && doc.caminho_arquivo.endsWith('.pdf')
                    a(href=doc.caminho_arquivo, target="_blank") Ver PDF
                  else if doc.caminho_arquivo
                    a(href=doc.caminho_arquivo, target="_blank")
                      img(src=doc.caminho_arquivo, alt="Documento", style="max-width:80px;max-height:80px;")
                // trocado form por botões que acionam AJAX no frontend
                td
                  button.btn.btn-success.btn-sm.aprovar-doc(type="button", data-id=doc.id_documento) Aprovar
                td
                  button.btn.btn-danger.btn-sm.rejeitar-doc(type="button", data-id=doc.id_documento) Rejeitar
          else
            tr
              td(colspan="8") Nenhum documento de verificação pendente.

    // Modal para visualizar documento de verificação
    div#modalDocumentoVerificacao.modal(style="display:none;")
      div.modal-dialog
        div.modal-content
          div.modal-header
            h5.modal-title Documento de Verificação
            button(type="button", class="close", onclick="fecharModalDocumentoVerificacao()") &times;
          div.modal-body
            p#modalDocumentoTipo
            p#modalDocumentoInstituicao
            p#modalDocumentoStatus
            p#modalDocumentoObservacoes
            if modalDocumentoArquivo && modalDocumentoArquivo.endsWith('.pdf')
              a#modalDocumentoArquivo(href=modalDocumentoArquivo, target="_blank") Ver Arquivo PDF
            else if modalDocumentoArquivo
              a(href=modalDocumentoArquivo, target="_blank")
                img(src=modalDocumentoArquivo, alt="Documento", style="max-width:200px;max-height:200px;")

    // Seção de Reports de Comentários
    h2.mt-5
      i.fas.fa-flag.mr-2
      | Comentários Reportados
    h4.mt-5(style="margin-top:40px;") Comentários Reportados
    .table-scroll(style="max-height:260px; overflow:auto; margin-bottom:32px;")
      table.table.table-striped
        thead
          tr
            th ID
            th Motivo
            th Visualizar
            th Previsualizar
            th Excluir
            th Ignorar
        tbody(id="comentariosReportadosTable")
          if reportsComentarios && reportsComentarios.length
            each report in reportsComentarios
              tr
                td= report.id_report
                td= report.motivo
                td
                  button.btn.btn-info.btn-sm.btn-visualizar-comentario(data-id=report.id_report) Visualizar
                td
                  button.btn.btn-secondary.btn-sm.btn-previsualizar-report(data-id=report.id_report, data-tipo="comentario") Previsualizar
                td
                  button.btn.btn-danger.btn-sm.btn-excluir-comentario-reportado(data-id=report.id_report) Excluir
                td
                  button.btn.btn-secondary.btn-sm.btn-ignorar-report(data-id=report.id_report, data-tipo="comentarios") Ignorar

    // Seção de Reports de Grupos
    h2.mt-5
      i.fas.fa-users.mr-2
      | Grupos Reportados
    h4.mt-5(style="margin-top:40px;") Grupos Reportados
    .table-scroll(style="max-height:260px; overflow:auto; margin-bottom:32px;")
      table.table.table-striped
        thead
          tr
            th ID
            th Grupo
            th Usuário
            th Motivo
            th Detalhes
            th Data
            th Status
            th Previsualizar
            th Excluir
            th Ignorar
        tbody
          if reportsGrupos && reportsGrupos.length
            each report in reportsGrupos
              tr
                td= report.id_report
                td= report.grupo ? report.grupo.nome_grupo : report.id_grupo
                td= report.usuario ? report.usuario.nome_usuario : report.id_usuario
                td= report.motivo
                td= report.detalhes
                td= report.data_report
                td= report.status
                td
                  button.btn.btn-secondary.btn-sm.btn-previsualizar-report(data-id=report.id_report, data-tipo="grupo") Previsualizar
                td
                  button.btn.btn-danger.btn-sm.btn-excluir-grupo-reportado(data-id=report.id_report) Excluir
                td
                  button.btn.btn-secondary.btn-sm.btn-ignorar-report(data-id=report.id_report, data-tipo="grupos") Ignorar

    // Seção de Reports de Eventos
    h2.mt-5
      i.fas.fa-calendar-alt.mr-2
      | Eventos Reportados
    h4.mt-5(style="margin-top:40px;") Eventos Reportados
    .table-scroll(style="max-height:260px; overflow:auto; margin-bottom:32px;")
      table.table.table-striped
        thead
          tr
            th ID
            th Evento
            th Usuário
            th Motivo
            th Detalhes
            th Data
            th Status
            th Previsualizar
            th Excluir
            th Ignorar
        tbody
          if reportsEventos && reportsEventos.length
            each report in reportsEventos
              tr
                td= report.id_report
                td= report.evento ? report.evento.titulo_evento : report.id_evento
                td= report.usuario ? report.usuario.nome_usuario : report.id_usuario
                td= report.motivo
                td= report.detalhes
                td= report.data_report
                td= report.status
                td
                  button.btn.btn-secondary.btn-sm.btn-previsualizar-report(data-id=report.id_report, data-tipo="evento") Previsualizar
                td
                  button.btn.btn-danger.btn-sm.btn-excluir-evento-reportado(data-id=report.id_report) Excluir
                td
                  button.btn.btn-secondary.btn-sm.btn-ignorar-report(data-id=report.id_report, data-tipo="eventos") Ignorar

    // Seção de Reports de Usuários
    h2.mt-5
      i.fas.fa-user.mr-2
      | Usuários Reportados
    h4.mt-5(style="margin-top:40px;") Usuários Reportados
    .table-scroll(style="max-height:260px; overflow:auto; margin-bottom:32px;")
      table.table.table-striped
        thead
          tr
            th ID
            th Usuário Denunciado
            th Denunciante
            th Motivo
            th Detalhes
            th Data
            th Status
            th Previsualizar
            th Aceitar
            th Ignorar
        tbody
          if reportsUsuarios && reportsUsuarios.length
            each report in reportsUsuarios
              tr
                td= report.id_report
                td= report.usuario ? report.usuario.nome_usuario : report.id_usuario
                td= report.denunciante ? report.denunciante.nome_usuario : report.id_denunciante
                td= report.motivo
                td= report.detalhes
                td= report.data_report
                td= report.status
                td
                  button.btn.btn-secondary.btn-sm.btn-previsualizar-report(data-id=report.id_report, data-tipo="usuario") Previsualizar
                td
                  button.btn.btn-success.btn-sm.btn-aceitar-report-usuario(
                    data-id=report.id_report,
                    data-usuario=report.id_usuario,
                    data-motivo=report.motivo
                  ) Aceitar
                td
                  button.btn.btn-secondary.btn-sm.btn-ignorar-report(data-id=report.id_report, data-tipo="usuarios") Ignorar

    // Seção de Postagens Reportadas (nova)
    h2.mt-5
      i.fas.fa-exclamation-triangle.mr-2
      | Postagens Reportadas
    .table-scroll(style="max-height:260px; overflow:auto; margin-bottom:32px;")
      table.table.table-striped
        thead
          tr
            th ID Report
            th Postagem
            th Autor
            th Motivo
            th Data
            th Visualizar
            th Excluir
            th Ignorar
        tbody
          if reportsPostagens && reportsPostagens.length
            each report in reportsPostagens
              tr
                td= report.id_report
                td= report.postagem ? report.postagem.titulo : report.id_postagem
                td= report.usuario ? report.usuario.nome_usuario : report.id_usuario
                td= report.motivo
                td= report.data_report
                td
                  button.btn.btn-secondary.btn-sm.btn-previsualizar-report(data-id=report.id_report, data-tipo="postagem") Previsualizar
                td
                  button.btn.btn-danger.btn-sm.btn-excluir-postagem-reportado(data-id=report.id_report) Excluir
                td
                  button.btn.btn-secondary.btn-sm.btn-ignorar-report(data-id=report.id_report, data-tipo="postagens") Ignorar
          else
            tr
              td(colspan="8") Nenhuma postagem reportada.

    // Modal de Previsualização Genérico
    div#modalPrevisualizarReport.modal.fade(tabindex="-1", aria-labelledby="modalPrevisualizarReportLabel", aria-hidden="true")
      div.modal-dialog
        div.modal-content
          div.modal-header
            h5.modal-title#modalPrevisualizarReportLabel Previsualizar Conteúdo Reportado
            button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Fechar")
          div.modal-body
            // Conteúdo dinâmico via JS
            div#modalPrevisualizarReportConteudo
          div.modal-footer
            button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Fechar

block scripts
  script(src="/blokdepalavroes.js")
  script(src="/javascripts/admin/super.js")
