extends ../layout

block styles
  link(rel="stylesheet", href="/stylesheets/admin/super.css")

block content
  .container.mt-4
    // Cabeçalho com estatísticas
    .row
      .col-md-3
        .stats-card
          .stats-number #{usuarios ? usuarios.length : 0}
          .stats-label Usuários Totais
      .col-md-3
        .stats-card
          .stats-number #{postagens ? postagens.length : 0}
          .stats-label Postagens
      .col-md-3
        .stats-card
          .stats-number#reportCount 0
          .stats-label Reports Pendentes
      .col-md-3
        .stats-card
          .stats-number#verificationCount 0
          .stats-label Verificações Pendentes

    // Seção de Usuários
    h2.mt-4
      i.fas.fa-users.mr-2
      | Gerenciamento de Usuários
    .search-box
      input.form-control#userSearch(type="text", placeholder="Buscar usuários...", oninput="filtrarUsuarios()")
    // Botão de criar categoria (apenas admin)
    if usuario && usuario.nivel_admin && usuario.nivel_admin !== 'user'
      a.btn.btn-success.mb-3(href="/categorias/create")
        i.fas.fa-folder-plus.me-2
        | Criar Nova Categoria
    h4.mt-4 Usuários do sistema
    .table-scroll(style="max-height:260px; overflow:auto;")
      table.table.table-striped
        thead
          tr
            th ID
            th Nome
            th Email
            th Advertências
            th Ações
        tbody(id="usuariosTable")
          each usuario in usuarios
            tr
              td= usuario.id_usuario
              td= usuario.nome_usuario || ''
              td= usuario.email || ''
              td
                span.badge.bg-warning= usuario.advertenciasCount || 0
              td
                .btn-group
                  // Botão banir/desbanir
                  if usuario.bloqueado
                    button.btn.btn-danger.btn-sm(type="button", data-desbanir-id=usuario.id_usuario) Desbanir
                  else
                    button.btn.btn-dark.btn-sm(type="button", data-bloquear-id=usuario.id_usuario) Banir
                  // Botão advertir
                  button.btn.btn-warning.btn-sm(type="button", data-advertir-id=usuario.id_usuario, data-advertir-nome=usuario.nome_usuario) Advertir

    // Seção de Postagens
    h2.mt-5
      i.fas.fa-file-alt.mr-2
      | Gerenciamento de Postagens
    .search-box
      input.form-control#postSearch(type="text", placeholder="Buscar postagens...", oninput="filtrarPostagens()")
    h4.mt-5 Postagens
    .table-scroll(style="max-height:260px; overflow:auto;")
      table.table.table-striped
        thead
          tr
            th ID
            th Autor
            th Título
            th Ações
        tbody(id="postagensTable")
          each post in postagens
            tr
              td= post.id_postagem
              td= post.id_autor
              td
                a(href="#", data-id=post.id_postagem) #{post.titulo}
              td
                form(action=`/admin/super/postagens/${post.id_postagem}/excluir`, method="POST", class="confirm-form", data-confirm="Excluir postagem?")
                  button.btn.btn-danger.btn-sm(type="submit") Excluir

    // Modal para visualizar postagem
    div#modalPostagem.modal(style="display:none;")
      div.modal-dialog
        div.modal-content
          div.modal-header
            h5.modal-title Conteúdo da Postagem
            // botao close sem onclick inline; data-target aponta para id do modal
            button(type="button", class="close btn-close-modal", data-target="modalPostagem") &times;
          div.modal-body
            p#modalConteudo
            img#modalImagem(style="max-width:100%;")

    // Seção de Reports
    h2.mt-5
      i.fas.fa-flag.mr-2
      | Postagens Reportadas
    h4.mt-5(style="margin-top:40px;") Postagens Reportadas
    .table-scroll(style="max-height:260px; overflow:auto; margin-bottom:32px;")
      table.table.table-striped
        thead
          tr
            th ID
            th Motivo
            th Visualizar
            th Excluir
        tbody(id="reportadasTable")
          // Preenchido via JS (JS ajustado abaixo para inserir class/data-confirm)

    // Modal para visualizar postagem reportada
    div#modalReportada.modal(style="display:none;")
      div.modal-dialog
        div.modal-content
          div.modal-header
            h5.modal-title Postagem Reportada
            button(type="button", class="close btn-close-modal", data-target="modalReportada") &times;
          div.modal-body
            p#modalReportadaMotivo
            div#modalReportadaConteudoBox(style="margin-bottom:10px;")
              label Título:
              pre#modalReportadaTitulo(style="white-space:pre-wrap; background:#f8f9fa; padding:8px; border-radius:4px;")
              label Conteúdo:
              pre#modalReportadaConteudo(style="white-space:pre-wrap; background:#f8f9fa; padding:8px; border-radius:4px;")
            div#modalReportadaImagemBox(style="margin-bottom:10px;")
              label Imagem:
              img#modalReportadaImagem(style="max-width:100%; border:1px solid #ddd; border-radius:4px; margin-top:4px;")
            form(id="formExcluirReportada", method="POST")
              button.btn.btn-danger(type="submit") Excluir

    // Modal para advertir usuário
    div#modalAdvertir.modal(style="display:none;")
      div.modal-dialog
        div.modal-content
          div.modal-header
            h5.modal-title Advertir Usuário
            button(type="button", class="close btn-close-modal", data-target="modalAdvertir") &times;
          div.modal-body
            p#modalAdvertirNome
            select.form-select#modalAdvertirMotivo
              option(value="Spam") Spam
              option(value="Conteúdo impróprio") Conteúdo impróprio
              option(value="Assédio") Assédio
              option(value="Outro") Outro
            textarea.form-control#modalAdvertirMsg(rows="3" placeholder="Detalhes (opcional)")
          div.modal-footer
            button.btn.btn-secondary(type="button", class="btn-cancel-advertir", data-target="modalAdvertir") Cancelar
            button.btn.btn-warning(type="button", id="btn-enviar-advertencia") Enviar Advertência
    // Modal banir/desbanir usuário
    div#modalBanir.modal(style="display:none;")
      div.modal-dialog
        div.modal-content
          div.modal-header
            h5.modal-title#modalBanirTitulo Banir/Desbanir Usuário
            button(type="button", class="close btn-close-modal", data-target="modalBanir") &times;
          div.modal-body
            p#modalBanirNome
            textarea.form-control#modalBanirMotivo(rows="3" placeholder="Motivo do banimento/desbanimento")
          div.modal-footer
            button.btn.btn-secondary(type="button", class="btn-cancel-banir", data-target="modalBanir") Cancelar
            button.btn.btn-dark(type="button", id="btn-enviar-banir") Confirmar

    // Seção de Verificações
    h2.mt-5
      i.fas.fa-check-circle.mr-2
      | Pedidos de Verificação
    div(style="margin-bottom:32px;")
      table.table.table-striped
        thead
          tr
            th ID
            th Usuário
            th Tipo Documento
            th Instituição
            th Status
            th Arquivo
            th Aprovar
            th Rejeitar
        tbody
          if docsVerificacao && docsVerificacao.length
            each doc in docsVerificacao
              tr
                td= doc.id_documento
                td= doc.usuario && doc.usuario.nome_usuario ? doc.usuario.nome_usuario : doc.id_usuario
                td= doc.tipo_documento
                td= doc.instituicao
                td= doc.status
                td
                  if doc.caminho_arquivo && doc.caminho_arquivo.endsWith('.pdf')
                    a(href=doc.caminho_arquivo, target="_blank") Ver PDF
                  else if doc.caminho_arquivo
                    a(href=doc.caminho_arquivo, target="_blank")
                      img(src=doc.caminho_arquivo, alt="Documento", style="max-width:80px;max-height:80px;")
                td
                  form.d-inline(method="POST", action=`/admin/super/documentos/${doc.id_documento}/aprovar`)
                    button.btn.btn-success.btn-sm(type="submit") Aprovar
                td
                  form.d-inline(method="POST", action=`/admin/super/documentos/${doc.id_documento}/rejeitar`)
                    button.btn.btn-danger.btn-sm(type="submit") Rejeitar
          else
            tr
              td(colspan="8") Nenhum documento de verificação pendente.

    // Modal para visualizar documento de verificação
    div#modalDocumentoVerificacao.modal(style="display:none;")
      div.modal-dialog
        div.modal-content
          div.modal-header
            h5.modal-title Documento de Verificação
            button(type="button", class="close", onclick="fecharModalDocumentoVerificacao()") &times;
          div.modal-body
            p#modalDocumentoTipo
            p#modalDocumentoInstituicao
            p#modalDocumentoStatus
            p#modalDocumentoObservacoes
            if modalDocumentoArquivo && modalDocumentoArquivo.endsWith('.pdf')
              a#modalDocumentoArquivo(href=modalDocumentoArquivo, target="_blank") Ver Arquivo PDF
            else if modalDocumentoArquivo
              a(href=modalDocumentoArquivo, target="_blank")
                img(src=modalDocumentoArquivo, alt="Documento", style="max-width:200px;max-height:200px;")

    // Seção de Reports de Comentários
    h2.mt-5
      i.fas.fa-flag.mr-2
      | Comentários Reportados
    h4.mt-5(style="margin-top:40px;") Comentários Reportados
    .table-scroll(style="max-height:260px; overflow:auto; margin-bottom:32px;")
      table.table.table-striped
        thead
          tr
            th ID
            th Motivo
            th Visualizar
            th Excluir
        tbody(id="comentariosReportadosTable")
          // Preenchido via JS

    // Modal para visualizar comentário reportado
    div#modalComentarioReportado.modal(style="display:none;")
      div.modal-dialog
        div.modal-content
          div.modal-header
            h5.modal-title Comentário Reportado
            button(type="button", class="close btn-close-modal", data-target="modalComentarioReportado") &times;
          div.modal-body
            p#modalComentarioReportadoMotivo
            div#modalComentarioReportadoConteudoBox(style="margin-bottom:10px;")
              label Autor:
              pre#modalComentarioReportadoAutor(style="white-space:pre-wrap; background:#f8f9fa; padding:8px; border-radius:4px;")
              label Conteúdo:
              pre#modalComentarioReportadoConteudo(style="white-space:pre-wrap; background:#f8f9fa; padding:8px; border-radius:4px;")
            form(id="formExcluirComentarioReportado", method="POST")
              button.btn.btn-danger(type="submit") Excluir

    // Seção de Reports de Grupos
    h2.mt-5
      i.fas.fa-users.mr-2
      | Grupos Reportados
    h4.mt-5(style="margin-top:40px;") Grupos Reportados
    .table-scroll(style="max-height:260px; overflow:auto; margin-bottom:32px;")
      table.table.table-striped
        thead
          tr
            th ID
            th Grupo
            th Usuário
            th Motivo
            th Detalhes
            th Data
            th Status
            th Ações
        tbody
          if reportsGrupos && reportsGrupos.length
            each report in reportsGrupos
              tr
                td= report.id_report
                td= report.grupo ? report.grupo.nome_grupo : report.id_grupo
                td= report.usuario ? report.usuario.nome_usuario : report.id_usuario
                td= report.motivo
                td= report.detalhes
                td= report.data_report
                td= report.status
                td
                  form(action=`/admin/super/reports-grupos/${report.id_report}/review`, method="POST")
                    button.btn.btn-success.btn-sm(type="submit") Marcar como revisado
                  form(action=`/admin/super/reports-grupos/${report.id_report}/dismiss`, method="POST")
                    button.btn.btn-secondary.btn-sm(type="submit") Ignorar

    // Seção de Reports de Eventos
    h2.mt-5
      i.fas.fa-calendar-alt.mr-2
      | Eventos Reportados
    h4.mt-5(style="margin-top:40px;") Eventos Reportados
    .table-scroll(style="max-height:260px; overflow:auto; margin-bottom:32px;")
      table.table.table-striped
        thead
          tr
            th ID
            th Evento
            th Usuário
            th Motivo
            th Detalhes
            th Data
            th Status
            th Ações
        tbody
          if reportsEventos && reportsEventos.length
            each report in reportsEventos
              tr
                td= report.id_report
                td= report.evento ? report.evento.titulo_evento : report.id_evento
                td= report.usuario ? report.usuario.nome_usuario : report.id_usuario
                td= report.motivo
                td= report.detalhes
                td= report.data_report
                td= report.status
                td
                  form(action=`/admin/super/reports-eventos/${report.id_report}/review`, method="POST")
                    button.btn.btn-success.btn-sm(type="submit") Marcar como revisado
                  form(action=`/admin/super/reports-eventos/${report.id_report}/dismiss`, method="POST")
                    button.btn.btn-secondary.btn-sm(type="submit") Ignorar

    // Seção de Reports de Usuários
    h2.mt-5
      i.fas.fa-user.mr-2
      | Usuários Reportados
    h4.mt-5(style="margin-top:40px;") Usuários Reportados
    .table-scroll(style="max-height:260px; overflow:auto; margin-bottom:32px;")
      table.table.table-striped
        thead
          tr
            th ID
            th Usuário Denunciado
            th Denunciante
            th Motivo
            th Detalhes
            th Data
            th Status
            th Ações
        tbody
          if reportsUsuarios && reportsUsuarios.length
            each report in reportsUsuarios
              tr
                td= report.id_report
                td= report.usuario ? report.usuario.nome_usuario : report.id_usuario
                td= report.denunciante ? report.denunciante.nome_usuario : report.id_denunciante
                td= report.motivo
                td= report.detalhes
                td= report.data_report
                td= report.status
                td
                  form(action=`/admin/super/reports-usuarios/${report.id_report}/review`, method="POST")
                    button.btn.btn-success.btn-sm(type="submit") Marcar como revisado
                  form(action=`/admin/super/reports-usuarios/${report.id_report}/dismiss`, method="POST")
                    button.btn.btn-secondary.btn-sm(type="submit") Ignorar

  script(src="/blokdepalavroes.js")
  script.
    // Filtragem de usuários
    function filtrarUsuarios() {
      const q = document.getElementById('userSearch').value.toLowerCase();
      const rows = document.querySelectorAll('#usuariosTable tr');
      rows.forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
      });
    }

    // Filtragem de postagens
    function filtrarPostagens() {
      const q = document.getElementById('postSearch').value.toLowerCase();
      const rows = document.querySelectorAll('#postagensTable tr');
      rows.forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      // Carrega listas via AJAX
      carregarReportadas();
      adicionarEventosAdvertir();
      carregarPedidosVerificacao();
      carregarComentariosReportados();

      // Inicializa botões que fecham modais (sem inline)
      document.querySelectorAll('.btn-close-modal, .btn-cancel-advertir').forEach(btn => {
        btn.addEventListener('click', function(e) {
          const targetId = this.dataset.target;
          if (targetId) {
            const el = document.getElementById(targetId);
            if (el) el.style.display = 'none';
          }
        });
      });

      // Fecha modal ao clicar no backdrop
      document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', function(e) {
          if (e.target === this) this.style.display = 'none';
        });
      });

      // Confirm prompts para forms que antes usavam onsubmit inline
      document.querySelectorAll('form.confirm-form').forEach(form => {
        form.addEventListener('submit', function(e) {
          const msg = this.dataset.confirm || 'Confirmar ação?';
          if (!confirm(msg)) e.preventDefault();
        });
      });

      // Enviar advertência (liga ao botão)
      const btnEnviar = document.getElementById('btn-enviar-advertencia');
      if (btnEnviar) {
        btnEnviar.addEventListener('click', function() {
          enviarAdvertencia();
        });
      }

      // Re-aplica eventos nas linhas carregadas dinamicamente (quando necessário)
      // observe/reattach: quando carregarReportadas() inserir linhas, ele já cria botões .ver-report que chamam abrirModalReportada
    });

    // Ajuste no carregamento de reports: crie forms sem onsubmit inline e com data-confirm
    function carregarReportadas() {
      fetch('/admin/super/postagens/reportadas')
        .then(res => {
          if (!res.ok) throw new Error('Erro ao buscar reports');
          return res.json();
        })
        .then(data => {
          const tbody = document.getElementById('reportadasTable');
          tbody.innerHTML = '';
          data.forEach(report => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td>${report.id_postagem}</td>
              <td>${report.motivo}</td>
              <td><button class="btn btn-info btn-sm ver-report" data-id="${report.id_report}" data-motivo="${report.motivo}" data-postagem="${report.id_postagem}">Ver</button></td>
              <td>
                <form action="/admin/super/postagens/${report.id_postagem}/excluir" method="POST" class="confirm-form" data-confirm="Excluir postagem reportada?">
                  <button class="btn btn-danger btn-sm" type="submit">Excluir</button>
                </form>
              </td>
            `;
            tbody.appendChild(tr);
          });

          // Adiciona eventos aos botões "Ver"
          document.querySelectorAll('.ver-report').forEach(btn => {
            btn.addEventListener('click', function() {
              abrirModalReportada(
                this.getAttribute('data-id'),
                this.getAttribute('data-motivo'),
                this.getAttribute('data-postagem')
              );
            });
          });

          // Reaplica confirmação em forms criados dinamicamente
          tbody.querySelectorAll('form.confirm-form').forEach(form => {
            form.addEventListener('submit', function(e) {
              const msg = this.dataset.confirm || 'Confirmar ação?';
              if (!confirm(msg)) e.preventDefault();
            });
          });
        })
        .catch(err => {
          const tbody = document.getElementById('reportadasTable');
          tbody.innerHTML = '<tr><td colspan="4">Erro ao carregar reports.</td></tr>';
        });
    }

    // Adiciona eventos aos links de postagens
    function adicionarEventosPostagens() {
      document.querySelectorAll('#postagensTable a[data-id]').forEach(link => {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          abrirModalPostagem(this.getAttribute('data-id'));
        });
      });
    }

    // Renderiza postagens e adiciona eventos
    function renderizarPostagens() {
      // ...renderização da tabela de postagens...
      adicionarEventosPostagens();
    }

    // Abrir modal de postagem
    function abrirModalPostagem(id) {
      fetch(`/admin/super/postagens/${id}/dados`)
        .then(res => res.json())
        .then((data) => {
          document.getElementById('modalConteudo').innerText = data.conteudo;
          document.getElementById('modalImagem').src = data.imagem || '';
          document.getElementById('modalPostagem').style.display = 'block';
        });
    }
    function fecharModalPostagem() {
      document.getElementById('modalPostagem').style.display = 'none';
    }

    // Abrir modal de postagem reportada
    function abrirModalReportada(id_report, motivo, id_postagem) {
      fetch(`/admin/super/reports/${id_report}`)
        .then(res => {
          if (!res.ok) throw new Error('Erro ao buscar report');
          return res.json();
        })
        .then(data => {
          document.getElementById('modalReportadaMotivo').innerText = 'Motivo: ' + motivo;
          let snapshot = {};
          try {
            snapshot = JSON.parse(data.snapshot_post);
          } catch (e) {
            snapshot = {};
          }
          document.getElementById('modalReportadaTitulo').innerText = snapshot.titulo || '(sem título)';
          document.getElementById('modalReportadaConteudo').innerText = snapshot.conteudo || '(sem conteúdo)';
          document.getElementById('modalReportadaImagem').src = snapshot.url_midia || '';
          document.getElementById('modalReportadaImagemBox').style.display = snapshot.url_midia ? 'block' : 'none';
          document.getElementById('formExcluirReportada').action = `/admin/super/postagens/${id_postagem}/excluir`;
          document.getElementById('modalReportada').style.display = 'block';
        })
        .catch(() => {
          alert('Erro ao abrir report.');
        });
    }
    function fecharModalReportada() {
      document.getElementById('modalReportada').style.display = 'none';
    }

    // Modal advertir usuário (mesma lógica: remova onclick inline e use evento JS)
    function adicionarEventosAdvertir() {
      document.querySelectorAll('.btn-warning[data-advertir-id]').forEach(btn => {
        btn.addEventListener('click', function() {
          abrirModalAdvertir(this.getAttribute('data-advertir-id'), this.getAttribute('data-advertir-nome'));
        });
      });
    }

    // Modal advertir usuário
    let usuarioAdvertirId = null;
    function abrirModalAdvertir(id, nome) {
      usuarioAdvertirId = id;
      document.getElementById('modalAdvertirNome').innerText = `Advertir usuário: ${nome}`;
      document.getElementById('modalAdvertirMotivo').value = '';
      document.getElementById('modalAdvertirMsg').value = '';
      document.getElementById('modalAdvertir').style.display = 'block';
    }
    function fecharModalAdvertir() {
      document.getElementById('modalAdvertir').style.display = 'none';
      usuarioAdvertirId = null;
    }
    document.getElementById('btn-enviar-advertencia').onclick = function() {
      const motivo = document.getElementById('modalAdvertirMotivo').value;
      const detalhes = document.getElementById('modalAdvertirMsg').value;
      fetch(`/admin/super/usuarios/${usuarioAdvertirId}/advertir`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ motivo, detalhes })
      }).then(() => {
        alert('Advertência enviada!');
        fecharModalAdvertir();
        location.reload();
      });
    };
    // Modal banir/desbanir
    let usuarioBanirId = null;
    let isDesbanir = false;
    function abrirModalBanir(id, desbanir) {
      usuarioBanirId = id;
      isDesbanir = desbanir;
      document.getElementById('modalBanirTitulo').innerText = desbanir ? 'Desbanir Usuário' : 'Banir Usuário';
      document.getElementById('modalBanirNome').innerText = `Usuário ID: ${id}`;
      document.getElementById('modalBanirMotivo').value = '';
      document.getElementById('modalBanir').style.display = 'block';
    }
    function fecharModalBanir() {
      document.getElementById('modalBanir').style.display = 'none';
      usuarioBanirId = null;
    }
    document.getElementById('btn-enviar-banir').onclick = function() {
      const motivo = document.getElementById('modalBanirMotivo').value;
      fetch(`/admin/super/usuarios/${usuarioBanirId}/${isDesbanir ? 'desbanir' : 'banir'}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ motivo })
      }).then(() => {
        alert(isDesbanir ? 'Usuário desbanido!' : 'Usuário banido!');
        fecharModalBanir();
        location.reload();
      });
    }

    // Carregar pedidos de verificação (documentos pendentes)
    function carregarPedidosVerificacao() {
      fetch('/admin/super/documentos/pendentes')
        .then(res => {
          if (!res.ok) throw new Error('Erro ao buscar documentos');
          return res.json();
        })
        .then(data => {
          const tbody = document.getElementById('verificacaoTable');
          tbody.innerHTML = '';
          data.forEach(doc => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td>${doc.id_documento}</td>
              <td>${doc.usuario_nome || doc.id_usuario}</td>
              <td>${doc.tipo_documento}</td>
              <td>${doc.instituicao || ''}</td>
              <td>${doc.status}</td>
              <td>
                <button class="btn btn-info btn-sm ver-doc" data-id="${doc.id_documento}">Ver</button>
              </td>
              <td>
                <button class="btn btn-success btn-sm aprovar-doc" data-id="${doc.id_documento}">Aprovar</button>
              </td>
              <td>
                <button class="btn btn-danger btn-sm rejeitar-doc" data-id="${doc.id_documento}">Rejeitar</button>
              </td>
            `;
            tbody.appendChild(tr);
          });

          // Eventos dos botões
          document.querySelectorAll('.ver-doc').forEach(btn => {
            btn.addEventListener('click', function() {
              abrirModalDocumentoVerificacao(this.getAttribute('data-id'));
            });
          });
          document.querySelectorAll('.aprovar-doc').forEach(btn => {
            btn.addEventListener('click', function() {
              aprovarDocumentoVerificacao(this.getAttribute('data-id'));
            });
          });
          document.querySelectorAll('.rejeitar-doc').forEach(btn => {
            btn.addEventListener('click', function() {
              rejeitarDocumentoVerificacao(this.getAttribute('data-id'));
            });
          });
        })
        .catch(err => {
          const tbody = document.getElementById('verificacaoTable');
          tbody.innerHTML = '<tr><td colspan="8">Erro ao carregar pedidos de verificação.</td></tr>';
        });
    }

    // Abrir modal documento verificação
    function abrirModalDocumentoVerificacao(id) {
      fetch(`/admin/super/documentos/${id}`)
        .then(res => res.json())
        .then(doc => {
          document.getElementById('modalDocumentoTipo').innerText = 'Tipo: ' + doc.tipo_documento;
          document.getElementById('modalDocumentoInstituicao').innerText = 'Instituição: ' + (doc.instituicao || '');
          document.getElementById('modalDocumentoStatus').innerText = 'Status: ' + doc.status;
          document.getElementById('modalDocumentoObservacoes').innerText = 'Observações: ' + (doc.observacoes || '');
          document.getElementById('modalDocumentoArquivo').href = doc.caminho_arquivo;
          document.getElementById('modalDocumentoArquivo').innerText = 'Ver Arquivo PDF';
          document.getElementById('modalDocumentoVerificacao').style.display = 'block';
        });
    }
    function fecharModalDocumentoVerificacao() {
      document.getElementById('modalDocumentoVerificacao').style.display = 'none';
    }

    // Aprovar documento
    function aprovarDocumentoVerificacao(id) {
      if (!confirm('Aprovar este documento?')) return;
      fetch(`/admin/super/documentos/${id}/aprovar`, { method: 'POST' })
        .then(() => {
          alert('Documento aprovado!');
          carregarPedidosVerificacao();
        });
    }

    // Rejeitar documento
    function rejeitarDocumentoVerificacao(id) {
      if (!confirm('Rejeitar este documento?')) return;
      fetch(`/admin/super/documentos/${id}/rejeitar`, { method: 'POST' })
        .then(() => {
          alert('Documento rejeitado!');
          carregarPedidosVerificacao();
        });
    }

    // Carregar comentários reportados
    function carregarComentariosReportados() {
      fetch('/admin/super/comentarios/reportados')
        .then(res => {
          if (!res.ok) throw new Error('Erro ao buscar reports de comentários');
          return res.json();
        })
        .then(data => {
          const tbody = document.getElementById('comentariosReportadosTable');
          tbody.innerHTML = '';
          data.forEach(report => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td>${report.id_comentario}</td>
              <td>${report.motivo}</td>
              <td><button class="btn btn-info btn-sm ver-comentario-report" data-id="${report.id_report}" data-motivo="${report.motivo}" data-comentario="${report.id_comentario}">Ver</button></td>
              <td>
                <form action="/admin/super/comentarios/${report.id_comentario}/excluir" method="POST" class="confirm-form" data-confirm="Excluir comentário reportado?">
                  <button class="btn btn-danger btn-sm" type="submit">Excluir</button>
                </form>
              </td>
            `;
            tbody.appendChild(tr);
          });

          // Adiciona eventos aos botões "Ver"
          document.querySelectorAll('.ver-comentario-report').forEach(btn => {
            btn.addEventListener('click', function() {
              abrirModalComentarioReportado(
                this.getAttribute('data-id'),
                this.getAttribute('data-motivo'),
                this.getAttribute('data-comentario')
              );
            });
          });

          // Reaplica confirmação em forms criados dinamicamente
          tbody.querySelectorAll('form.confirm-form').forEach(form => {
            form.addEventListener('submit', function(e) {
              const msg = this.dataset.confirm || 'Confirmar ação?';
              if (!confirm(msg)) e.preventDefault();
            });
          });
        })
        .catch(err => {
          const tbody = document.getElementById('comentariosReportadosTable');
          tbody.innerHTML = '<tr><td colspan="4">Erro ao carregar reports de comentários.</td></tr>';
        });
    }

