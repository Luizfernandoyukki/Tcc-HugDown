            snapshot = {};
          }
          document.getElementById('modalComentarioReportadoAutor').innerText = snapshot.autor || '(sem autor)';
          document.getElementById('modalComentarioReportadoConteudo').innerText = snapshot.conteudo || '(sem conteúdo)';
          document.getElementById('formExcluirComentarioReportado').action = `/admin/super/comentarios/${id_comentario}/excluir`;
          document.getElementById('modalComentarioReportado').style.display = 'block';
        })
        .catch(() => {
          alert('Erro ao abrir report de comentário.');
        });
    }
