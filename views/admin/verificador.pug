extends ../layout

block styles
  link(rel="stylesheet", href="/stylesheets/admin/verificador.css")

block content
  .container.mt-5
    h2 Painel Verificador
    p.text-muted Você pode aprovar ou rejeitar documentos de verificação.
    if docs && docs.length
      table.table.table-striped.mt-4
        thead
          tr
            th ID
            th Usuário
            th Tipo
            th Instituição
            th Status
            th Data
            th Ações
        tbody
          each doc in docs
            if doc.status === 'approved'
              tr
                td= doc.id_documento
                td= doc.usuario?.nome_usuario || 'N/A'
                td= doc.tipo_documento
                td= doc.instituicao
                td= doc.status
                td= doc.data_submissao
                td
                  // Nenhuma ação para documentos já verificados
    else
      p.text-muted Nenhum documento verificado.
    else
      p.text-muted Nenhum documento pendente.
